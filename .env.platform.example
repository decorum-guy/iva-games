# Local development only. Copy the needed settings into ignored .env.
# Do not commit real SMTP, Telegram or proxy secrets.
NODE_ENV=development
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=4310
PORTAL_ORIGIN=http://127.0.0.1:5175
PLATFORM_DATABASE_PATH=.runtime/platform.sqlite
PLATFORM_LAB_DATABASE_PATH=.runtime/platform-lab.sqlite
MAIL_MODE=file
MAIL_FILE_DIRECTORY=.runtime/platform-mail

# To serve a built portal from this same process, set PORTAL_ORIGIN to
# its actual origin and uncomment this directory:
# PORTAL_DIST_DIRECTORY=apps/portal/dist

# Production: HTTPS portal origin and a real SMTP transport are required.
# NODE_ENV=production
# PORTAL_ORIGIN=https://<chosen-portal-domain>
# PLATFORM_ALLOWED_ORIGINS=https://<chosen-portal-domain>
# PLATFORM_ALLOWED_HOSTS=<chosen-portal-domain>
# MAIL_MODE=smtp
# SMTP_HOST=<existing-mail-host>
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<secret>
# SMTP_FROM=<authorized-sender-address>

# Optional Telegram integration is disabled until explicitly configured.
# All enabled fields are mandatory. The portal must use HTTPS.
TELEGRAM_ENABLED=false
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_USERNAME=<dedicated-bot-username>
# TELEGRAM_BOT_TOKEN=<dedicated-bot-token>
# TELEGRAM_WEBHOOK_SECRET=<32-to-256-random-base64url-characters>
# TELEGRAM_PROOF_KEY_BASE64=<canonical-base64-encoding-of-32-random-bytes>
# TELEGRAM_PROXY_URL=<actual-http-https-or-socks5h-route-through-kz-bot>
# Inspect the existing approved proxy configuration; do not invent its port.
# Configuring these values does not register Telegram's webhook automatically.
