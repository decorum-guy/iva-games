{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "District v0.2 map profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "width", "height", "rows", "supportedPlayers"],
  "$defs": { "localized": { "type": "object", "additionalProperties": false, "required": ["ru", "en"], "properties": { "ru": { "type": "string", "minLength": 1, "maxLength": 240 }, "en": { "type": "string", "minLength": 1, "maxLength": 240 } } } },
  "properties": {
    "$schema": { "const": "../map.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]{0,5}$" },
    "name": { "$ref": "#/$defs/localized", "properties": { "ru": { "maxLength": 60 }, "en": { "maxLength": 60 } } },
    "description": { "$ref": "#/$defs/localized" },
    "width": { "const": 5 }, "height": { "const": 5 },
    "rows": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "pattern": "^[.HPS]{5}$" } },
    "supportedPlayers": { "const": [2, 3, 4] }
  }
}
