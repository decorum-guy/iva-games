  "private": true,
  "type": "module",
  "exports": {
    "./core": "./src/core/index.ts",
    "./online/protocol": "./src/online/protocol.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
