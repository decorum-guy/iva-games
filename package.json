{
  "name": "remorse-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "preview": "vite preview",
    "auditions:build": "tsc --noEmit && vite build --config vite.auditions.config.ts",
    "auditions:preview": "vite preview --config vite.auditions.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "auditions:test": "playwright test --config playwright.auditions.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:e2e": "playwright test",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/main.js",
    "dev:server": "npm run build:server && node --watch dist-server/main.js",
    "test:online": "vitest run tests/unit/online*.test.ts",
    "overdrive:dev": "vite --host 127.0.0.1 --port 5185 --strictPort",
    "overdrive:test": "vitest run tests/unit/overdrive*.test.ts",
    "overdrive:e2e": "playwright test --config playwright.overdrive.config.ts",
    "overdrive:smoke": "node scripts/overdrive-smoke.mjs",
    "overdrive:balance": "node scripts/overdrive-balance.mjs",
    "overdrive:models": "node scripts/generate-overdrive-models.mjs",
    "overdrive:audio": "python3 scripts/generate-overdrive-audio.py",
    "sdk:test": "vitest run src/sdk src/engine/search.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-sqlite3": "13.2.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
