# For Node's --env-file option. Local development does not need PUBLIC_ORIGIN.
HOST=0.0.0.0
PORT=4173
DATABASE_PATH=./data/remorse.sqlite
STATIC_DIR=./dist
# Development frontend, when running Vite separately:
DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set both of these for the public server behind HTTPS:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://remorse.chess-2.online
ROOM_INACTIVE_MS=86400000
FINISHED_ROOM_MS=604800000
