#!/bin/sh
# Fixed SSH entry point. No commands or stdin protocol are accepted.
set -eu
if [ "$#" -ne 0 ] || [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  echo 'This key accepts only a no-command server snapshot.' >&2
  exit 2
fi
exec /usr/bin/timeout --kill-after=3s 40s /usr/bin/sudo -n -- \
  /opt/iva-games/ops/ops-status.py </dev/null
